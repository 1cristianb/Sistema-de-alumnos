@model Entidades.Alumno
@{
    ViewData["Title"] = "Registro de Nuevo Alumno";
    string tipoSeleccionado = ViewBag.TipoBD ?? "LiteDB";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card p-4 p-md-5">
            <div class="border-bottom pb-3 mb-4 d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="fw-bold text-dark mb-1"><i class="bi bi-person-vcard text-primary me-2"></i>Alta de Alumno</h3>
                    <p class="text-muted small mb-0">Completa todos los campos obligatorios para registrar al estudiante en el sistema.</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Volver al Listado
                </a>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.Error
                </div>
            }

            <form asp-action="Alta" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <!-- Selector de Base de Datos NoSQL -->
                <div class="alert alert-light border d-flex align-items-center justify-content-between p-3 mb-4">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-database-fill-gear fs-4 text-primary me-3"></i>
                        <div>
                            <div class="fw-semibold">Motor de Persistencia NoSQL</div>
                            <small class="text-muted">Elige en qué motor NoSQL deseas guardar este registro</small>
                        </div>
                    </div>
                    <div style="min-width: 200px;">
                        <select name="tipoBD" class="form-select">
                            <option value="LiteDB" selected="@(tipoSeleccionado == "LiteDB")">LiteDB (Local .db)</option>
                            <option value="MongoDB" selected="@(tipoSeleccionado == "MongoDB")">MongoDB (Documentos)</option>
                        </select>
                    </div>
                </div>

                <partial name="_FormAlumno" />

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save2 me-1"></i> Guardar Alumno
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}