@model Entidades.Alumno
@{
    ViewData["Title"] = "Editar Alumno";
    string tipoBD = ViewBag.TipoBD;
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card p-4 p-md-5">
            <div class="border-bottom pb-3 mb-4 d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="fw-bold text-dark mb-1"><i class="bi bi-pencil-square text-primary me-2"></i>Editar Alumno</h3>
                    <p class="text-muted small mb-0">
                        Este alumno está guardado en
                        <span class="badge @(tipoBD == "MongoDB" ? "bg-success" : "bg-info text-dark")">@tipoBD</span>
                    </p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Volver al Listado
                </a>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.Error
                </div>
            }

            <form asp-action="Editar" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <input type="hidden" asp-for="Id" />
                <input type="hidden" name="tipoBD" value="@tipoBD" />

                <partial name="_FormAlumno" />

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save2 me-1"></i> Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
