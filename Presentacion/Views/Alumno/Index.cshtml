@model List<Entidades.AlumnoListadoItem>
@{
    ViewData["Title"] = "Listado General de Alumnos";
    string tipoActual = ViewBag.TipoBDActual ?? "Todas";
    var advertencias = ViewBag.Advertencias as List<string>;
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (advertencias != null)
{
    foreach (var advertencia in advertencias)
    {
        <div class="alert alert-warning mb-3" role="alert">
            <i class="bi bi-database-exclamation me-2"></i>@advertencia
        </div>
    }
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-0 text-dark">Alumnos y Cursos Inscriptos</h3>
        <span class="badge bg-secondary">Mostrando: @(tipoActual == "Todas" ? "todas las bases" : tipoActual)</span>
        <span class="badge bg-light text-dark border">@Model.Count alumno(s)</span>
    </div>
    <a asp-action="Alta" class="btn btn-success shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Dar de Alta Alumno
    </a>
</div>

<partial name="_BuscadorPartial" />

<div class="card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Alumno</th>
                    <th>DNI / Legajo</th>
                    <th>Base</th>
                    <th>Carrera</th>
                    <th>Puntaje Ingreso</th>
                    <th>Fecha Nacimiento</th>
                    <th>Contacto</th>
                    <th>Cursos Asociados</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Count > 0)
                {
                    foreach (var item in Model)
                    {
                        var alumno = item.Alumno;
                        <tr>
                            <td>
                                <div class="fw-bold">@alumno.Apellido, @alumno.Nombre</div>
                                <small class="text-muted"><i class="bi bi-geo-alt"></i> @alumno.Direccion</small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@alumno.DNI</span>
                                <div><small class="text-muted">@alumno.Legajo</small></div>
                            </td>
                            <td>
                                <span class="badge @(item.BaseDatos == "MongoDB" ? "bg-success" : "bg-info text-dark")">@item.BaseDatos</span>
                            </td>
                            <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle">@alumno.Carrera</span></td>
                            <td>
                                <span class="badge @(alumno.PuntajeIngreso >= 700 ? "bg-success" : "bg-warning text-dark")">
                                    @alumno.PuntajeIngreso pts
                                </span>
                            </td>
                            <td>@alumno.FechaNacimiento.ToString("dd/MM/yyyy")</td>
                            <td>
                                <div><small><i class="bi bi-envelope"></i> @alumno.Email</small></div>
                                <div><small><i class="bi bi-telephone"></i> @alumno.Telefono</small></div>
                            </td>
                            <td>
                                <!-- Entidad de relación: cursos reales del alumno -->
                                @if (item.Cursos.Count == 0)
                                {
                                    <small class="text-muted">Sin cursos</small>
                                }
                                @foreach (var curso in item.Cursos)
                                {
                                    <form asp-controller="Curso" asp-action="Eliminar" method="post" class="d-inline"
                                          onsubmit="return confirm('¿Quitar el curso @curso.NombreCurso?');">
                                        <input type="hidden" name="id" value="@curso.Id" />
                                        <input type="hidden" name="tipoBD" value="@item.BaseDatos" />
                                        <span class="badge bg-info text-dark me-1 mb-1">
                                            <i class="bi bi-journal-code"></i> @curso.NombreCurso
                                            <span class="opacity-75">@curso.Anio</span>
                                            <button type="submit" class="btn-close ms-1" style="font-size:.55em" title="Quitar curso"></button>
                                        </span>
                                    </form>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-controller="Curso" asp-action="Alta" asp-route-alumnoId="@alumno.Id" asp-route-tipoBD="@item.BaseDatos"
                                   class="btn btn-sm btn-outline-success" title="Agregar curso">
                                    <i class="bi bi-journal-plus"></i>
                                </a>
                                <a asp-action="Editar" asp-route-id="@alumno.Id" asp-route-tipoBD="@item.BaseDatos"
                                   class="btn btn-sm btn-outline-primary" title="Editar">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <form asp-action="Eliminar" method="post" class="d-inline"
                                      onsubmit="return confirm('¿Eliminar a @alumno.Nombre @alumno.Apellido y todos sus cursos?');">
                                    <input type="hidden" name="id" value="@alumno.Id" />
                                    <input type="hidden" name="tipoBD" value="@item.BaseDatos" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                            No se encontraron alumnos con los filtros elegidos.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
