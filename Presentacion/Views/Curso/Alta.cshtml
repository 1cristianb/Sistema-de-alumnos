@model Entidades.Curso
@{
    ViewData["Title"] = "Agregar Curso";
    var alumno = (Entidades.Alumno)ViewBag.Alumno;
    string tipoBD = ViewBag.TipoBD;
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card p-4 p-md-5">
            <div class="border-bottom pb-3 mb-4 d-flex justify-content-between align-items-center">
                <div>
                    <h3 class="fw-bold text-dark mb-1"><i class="bi bi-journal-plus text-success me-2"></i>Agregar Curso</h3>
                    <p class="text-muted small mb-0">El curso queda asociado al alumno elegido.</p>
                </div>
                <a asp-controller="Alumno" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Volver
                </a>
            </div>

            <div class="alert alert-light border d-flex align-items-center mb-4">
                <i class="bi bi-person-fill fs-4 text-primary me-3"></i>
                <div>
                    <div class="fw-semibold">@alumno.Apellido, @alumno.Nombre</div>
                    <small class="text-muted">
                        DNI @alumno.DNI ·
                        <span class="badge @(tipoBD == "MongoDB" ? "bg-success" : "bg-info text-dark")">@tipoBD</span>
                    </small>
                </div>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.Error
                </div>
            }

            <form asp-action="Alta" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <input type="hidden" asp-for="AlumnoId" />
                <input type="hidden" name="tipoBD" value="@tipoBD" />

                <div class="row g-3 mb-4">
                    <div class="col-md-8">
                        <label asp-for="NombreCurso" class="form-label small fw-semibold">Nombre del curso</label>
                        <input asp-for="NombreCurso" class="form-control" placeholder="Ej: Programación Avanzada II" />
                        <span asp-validation-for="NombreCurso" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Anio" class="form-label small fw-semibold">Año</label>
                        <input asp-for="Anio" class="form-control" />
                        <span asp-validation-for="Anio" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-controller="Alumno" asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-save2 me-1"></i> Guardar Curso
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
