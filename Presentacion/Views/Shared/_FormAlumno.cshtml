@model Entidades.Alumno

<h5 class="fw-semibold text-secondary mb-3"><i class="bi bi-person-lines-fill me-2"></i>Datos Personales</h5>
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <label asp-for="Nombre" class="form-label small fw-semibold">Nombre</label>
        <input asp-for="Nombre" class="form-control" placeholder="Ej: Cristian" />
        <span asp-validation-for="Nombre" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Apellido" class="form-label small fw-semibold">Apellido</label>
        <input asp-for="Apellido" class="form-control" placeholder="Ej: Gómez" />
        <span asp-validation-for="Apellido" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="DNI" class="form-label small fw-semibold">DNI</label>
        <input asp-for="DNI" class="form-control" placeholder="Sin puntos" />
        <span asp-validation-for="DNI" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Legajo" class="form-label small fw-semibold">Legajo</label>
        <input asp-for="Legajo" class="form-control" placeholder="Ej: L-1005" />
        <span asp-validation-for="Legajo" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Telefono" class="form-label small fw-semibold">Teléfono</label>
        <input asp-for="Telefono" class="form-control" placeholder="Ej: 11 3456-7890" />
        <span asp-validation-for="Telefono" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Email" class="form-label small fw-semibold">Correo Electrónico</label>
        <input asp-for="Email" type="email" class="form-control" placeholder="alumno@unlam.edu.ar" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Direccion" class="form-label small fw-semibold">Dirección</label>
        <input asp-for="Direccion" class="form-control" placeholder="Calle, número, localidad" />
        <span asp-validation-for="Direccion" class="text-danger small"></span>
    </div>
</div>

<h5 class="fw-semibold text-secondary mb-3"><i class="bi bi-mortarboard me-2"></i>Datos Académicos</h5>
<div class="row g-3 mb-4">
    <!-- Campo Combo -->
    <div class="col-md-4">
        <label asp-for="Carrera" class="form-label small fw-semibold">Carrera (Combo)</label>
        <select asp-for="Carrera" class="form-select">
            <option value="">Seleccione una opción...</option>
            <option value="Licenciatura en Gestión de la Tecnología">Lic. en Gestión de la Tecnología</option>
            <option value="Ingeniería en Informática">Ingeniería en Informática</option>
            <option value="Tecnicatura Universitaria en Web">Tecnicatura Web</option>
        </select>
        <span asp-validation-for="Carrera" class="text-danger small"></span>
    </div>

    <!-- Campo Fecha -->
    <div class="col-md-4">
        <label asp-for="FechaNacimiento" class="form-label small fw-semibold">Fecha de Nacimiento</label>
        <input asp-for="FechaNacimiento" class="form-control" />
        <span asp-validation-for="FechaNacimiento" class="text-danger small"></span>
    </div>

    <!-- Campo Numérico 1 a 1000 -->
    <div class="col-md-4">
        <label asp-for="PuntajeIngreso" class="form-label small fw-semibold">Puntaje Ingreso (1 a 1000)</label>
        <input asp-for="PuntajeIngreso" class="form-control" placeholder="Ej: 850" />
        <span asp-validation-for="PuntajeIngreso" class="text-danger small"></span>
    </div>
</div>